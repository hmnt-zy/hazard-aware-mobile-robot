<robot
  name="BB2">

<!-- Standard ROS base_footprint on the floor -->
  <link name="base_footprint"/>
  <link name="base_link"/>
  <link name="laser"/>

  <!-- Aligns your SolidWorks base_link to the ROS X-Forward convention -->
  <joint name="base_footprint_joint" type="fixed">
    <!-- 
      Z = 0.01825 elevates base_link so the wheels touch the floor.
      Yaw = 3.14159265 (180 degrees) rotates X to the front and Y to the left.
    -->
    <origin xyz="0 0 0.01825" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 1.57079632679" />
    <parent link="base_link" />
    <child link="original_base_link" />
  </joint>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 -1.57079632679" />
    <parent link="lidar" />
    <child link="laser" />
  </joint>



  <link
    name="original_base_link">
    <inertial>
      <origin
        xyz="-8.0385E-05 0.0016598 0.071351"
        rpy="0 0 0" />
      <mass
        value="1.0885" />
      <inertia
        ixx="0.002276"
        ixy="8.5132E-06"
        ixz="2.934E-06"
        iyy="0.0023098"
        iyz="5.8604E-05"
        izz="0.0040137" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>


    <!-- Main chassis collision -->
  <collision name="chassis_collision">
    <origin xyz="0 0 0.02555" rpy="0 0 0"/>
    <geometry>
      <box size="0.2203 0.2203 0.0755"/>
    </geometry>
  </collision>

  <!-- Front caster -->
  <collision name="front_caster_collision">
    <origin xyz="0 -0.0842 -0.00625" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.012"/>
    </geometry>
  </collision>

  <!-- Rear caster -->
  <collision name="rear_caster_collision">
    <origin xyz="0 0.0842 -0.00625" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.012"/>
    </geometry>
  </collision>
    


  </link>
  <link
    name="left">
    <inertial>
      <origin
        xyz="-1.4815E-09 2.6796E-10 0.0041022"
        rpy="0 0 0" />
      <mass
        value="0.03468" />
      <inertia
        ixx="1.5221E-05"
        ixy="-4.9032E-10"
        ixz="2.0622E-13"
        iyy="1.522E-05"
        iyz="-4.4842E-14"
        izz="2.578E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/left.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/left.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="j1"
    type="continuous">
    <origin
      xyz="0.0835000000000001 0 0.01425"
      rpy="-1.5707963267949 0 -1.5707963267949" />
    <parent
      link="original_base_link" />
    <child
      link="left" />
    <axis
      xyz="0 0 1" />
  </joint>
  <link
    name="right">
    <inertial>
      <origin
        xyz="1.0241E-09 1.1425E-09 0.0041022"
        rpy="0 0 0" />
      <mass
        value="0.03468" />
      <inertia
        ixx="1.5221E-05"
        ixy="4.0618E-10"
        ixz="-1.5048E-13"
        iyy="1.522E-05"
        iyz="-1.522E-13"
        izz="2.578E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/right.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/right.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="j2"
    type="continuous">
    <origin
      xyz="-0.0832999999999999 0 0.0142500000000002"
      rpy="1.5707963267949 0 -1.5707963267949" />
    <parent
      link="original_base_link" />
    <child
      link="right" />
    <axis
      xyz="0 0 -1" />
  </joint>
  <link
    name="lidar_mesh">
    <inertial>
      <origin
        xyz="0.010274 -0.018202 0.0035346"
        rpy="0 0 0" />
      <mass
        value="0.073084" />
      <inertia
        ixx="1.9691E-05"
        ixy="-4.1969E-07"
        ixz="-7.0642E-07"
        iyy="4.1418E-05"
        iyz="-8.6284E-08"
        izz="2.4015E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/lidar.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/lidar.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="base_lidar"
    type="fixed">
    <origin
      xyz="0.00149427609496322 0.0158678433509948 0.222837014511582"
      rpy="0 0 0" />
    <parent
      link="original_base_link" />
    <child
      link="lidar" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="camera_tilt">
    <inertial>
      <origin
        xyz="-5.0351E-07 0.021587 0.0023344"
        rpy="0 0 0" />
      <mass
        value="0.047449" />
      <inertia
        ixx="5.1216E-06"
        ixy="-8.2978E-12"
        ixz="6.5811E-11"
        iyy="2.5545E-05"
        iyz="-4.2447E-08"
        izz="2.6753E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/camera_tilt.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://beetlebot_description/meshes/camera_tilt.STL" />
      </geometry>
    </collision>
  </link>

<link name="lidar"/>

<joint name="lidar_mesh_joint" type="fixed">
  <origin
    xyz="0 0 0"
    rpy="1.5707963267949 0 0"/>
  <parent link="lidar"/>
  <child link="lidar_mesh"/>
</joint>


  <joint
    name="base_camera"
    type="fixed"> <!-- type="revolute" -->
    <origin
      xyz="-0.00059463 -0.089954 0.11595"
      rpy="2.0208 0 0" />
    <parent
      link="original_base_link" />
    <child
      link="camera_tilt" />
    <axis
      xyz="0.9987 0 0.050926" />
    <!-- <limit
      lower="-0.14"
      upper="0.45"
      effort="0"
      velocity="0" /> -->
  </joint>


  <gazebo>
    
    <!-- Differential Drive Plugin -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>j1</left_joint>
      <right_joint>j2</right_joint>
      <!-- Wheel separation based on URDF j1 x(0.0835) - j2 x(-0.0833) -->
      <!-- <wheel_separation>0.1668</wheel_separation> -->
      <!-- <wheel_radius>0.0325</wheel_radius> -->

      <wheel_separation>0.1668</wheel_separation> <!-- 238 mm -->
      <wheel_radius>0.0325</wheel_radius>       <!-- 65 mm / 2 = 32.5 mm -->

      <odom_publish_frequency>100</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- Joint State Publisher Plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

  </gazebo>

  <gazebo reference="lidar">
<sensor name='gpu_lidar' type='gpu_lidar'>
    <pose relative_to='lidar'>0 0 0 0 0 0</pose>
    <topic>scan</topic>
    <gz_frame_id>lidar</gz_frame_id>
    <update_rate>10</update_rate>
    <ray>
        <scan>
            <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14</min_angle>
                <max_angle>3.14</max_angle>
            </horizontal>
            <vertical>
                <samples>1</samples>
                <resolution>0.01</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
            </vertical>
        </scan>
        <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
        </range>
         <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.02</stddev>
                </noise>
    </ray>
    <always_on>1</always_on>
    <visualize>true</visualize>

    <!-- <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin> -->
</sensor></gazebo>




<!-- Invisible optical frame link for ROS TF -->
  <link name="camera_link">
  </link>

  <!-- Joint attaching the optical frame to your physical camera_tilt mesh -->
  <joint name="camera_link_joint" type="fixed">
    <!-- 
      XYZ: Shifts the frame from the pivot point to the physical center of the lens. 
           (Adjust 0.0215 and 0.0023 if your lens is slightly off from the Center of Mass).
      RPY: Standard ROS optical rotation (-pi/2, 0, -pi/2) to orient Z forward.
    -->

    <!-- 
      -->
    <origin xyz="0.0 0.0215 0.01" rpy="-1.57079632679 -1.57079632679 0.0" />    
    <parent link="camera_tilt" />
    <child link="camera_link" />
  </joint>

  <!-- Standard Optical Frame (Z-Forward, X-Right, Y-Down) -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963" />
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
  </joint>


 <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>1.151917</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>480</width>
                    <height>640</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <topic>camera/image_raw</topic>
            <gz_frame_id>camera_optical_frame</gz_frame_id>
        </sensor>
    </gazebo>



</robot>